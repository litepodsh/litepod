# Local setup (run from apps/): copy this file and fill the required secrets:
#   cp api/.env.example api/.env
#   perl -pi -e 's/^(ENCRYPTION_KEY|HASH_SECRET|METRICS_PASSWORD)=$/"$1=".substr(`openssl rand -hex 32`,0,64)/e' api/.env
# The API refuses to boot without ENCRYPTION_KEY, HASH_SECRET and the metrics
# credentials. Generate fresh values; never reuse these placeholders in production.

# API
PORT=6001
IS_CLOUD=false
TEMPLATES_CATALOG_URL=https://templates.litepod.sh/

# Version (bumped by `just bump`; shown on the System page)
LITEPOD_VERSION=v0.3.3
CADDY_VERSION=2.11.4
DFLY_VERSION=v2.0.2
DFLY_PASSWORD=litepod-dev-dragonfly

# DB
DATABASE_PATH=./data/litepod.db
DRAGONFLY_URL=redis://:litepod-dev-dragonfly@127.0.0.1:6379

# Caddy
CADDY_URL=http://localhost
CADDY_ADMIN_URL=http://localhost:2019
CADDY_SERVER_UPSTREAM=host.containers.internal:6002

# Podman socket. Linux rootless: unix:///run/user/1000/podman/podman.sock
# macOS: run `podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}'`
PODMAN_SOCKET=unix:///run/user/1000/podman/podman.sock

# Public URL (use a tunnel in dev so GitHub can reach webhooks)
PUBLIC_URL=http://localhost:6001
LITEPOD_PUBLIC_IP=127.0.0.1
LITEPOD_DEV_MODE=1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:6002,http://litepod.localhost:8080

# Secrets (required). Generate each one with:
#   openssl rand -hex 32
# Must be exactly 64 hex characters.
ENCRYPTION_KEY=
# Any non-empty value.
HASH_SECRET=

# Metrics basic auth (/metrics)
METRICS_USERNAME=admin
METRICS_PASSWORD=

# Optional
# LOKI_URL=
# LOKI_SERVICE=litepod
RUST_LOG=info
# RESEND_API_KEY=            # email verification, cloud registrations only
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2
# TURNSTILE_SECRET=
