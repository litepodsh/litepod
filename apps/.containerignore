# Build contexts are tarred and streamed to Podman on every build. Without these
# entries the context carries multi-gigabyte artifact directories that the images
# rebuild from source anyway.

# Rust build artifacts
api/target/
# ...except the binaries built on the host (arm64 by `cross`, amd64 by the
# release workflow), which the build COPYs in via --build-arg PREBUILT_API
# (see Dockerfile).
!api/target/aarch64-unknown-linux-gnu/release/litepod-api
!api/target/release/litepod-api

# Node/Bun artifacts
ui/node_modules/
ui/.svelte-kit/
ui/build/

# Runtime state: cloned repos, generated compose files, the local libsql database
api/data/

.git/
