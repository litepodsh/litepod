# podx — Litepod release pipeline config
# Copy to .env and fill in. Never commit .env.
# This file lives on the DEVELOPER MACHINE (your Mac).
# Runtime vars (secrets, URLs, update config) live in api/.env on each
# server; the install-staging.sh script bootstraps those from defaults.

# ─── DockerHub ───────────────────────────────────────────────────────
DOCKERHUB_USER=litepod
DOCKERHUB_REPO=litepod
DOCKERHUB_NAMESPACE=docker.io
# PAT scoped to litepod/litepod only (Hub → repo → Settings → Security →
# New Access Token). Do NOT use your account password here.
DOCKERHUB_TOKEN=

# ─── Versioning ────────────────────────────────────────────────────
# api/.env holds both full immutable tags: LITEPOD_VERSION for stable and
# LITEPOD_VERSION for alpha. `just podx-bump` edits only stable.
# Publish stable with `just release-dockerhub`; Just requires the separator
# for alpha: `just release-dockerhub -- --alpha`.

# ─── Release manifest (just publish-version) ─────────────────────────
# Where the published version.json (and install.sh/uninstall.sh) live.
# Instances read version.json anonymously to discover new versions, so these
# keys are only needed on the machine that cuts releases — never on a server.
# Must match the LITEPOD_VERSION_MANIFEST_URL default baked into
# api/src/main.rs (bucket "litepod"), or deployed instances will never see
# new releases.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=litepod
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Build target ────────────────────────────────────────────────────
TARGET_PLATFORM=linux/amd64
BUILDER_BUN_IMAGE=docker.io/oven/bun:1-alpine
BUILDER_RUST_IMAGE=docker.io/rust:1-slim-bookworm
RUNTIME_IMAGE=gcr.io/distroless/cc-debian12
