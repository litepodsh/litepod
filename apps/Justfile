# Format all code: API (cargo fmt) and UI (oxfmt).
fmt: api-fmt ui-fmt

# Generate a disposable 30-day self-signed certificate for Settings → Certificates.
# Usage: just self-signed-cert test.example.com
self-signed-cert domain:
    #!/usr/bin/env bash
    set -euo pipefail
    domain='{{domain}}'
    if [[ ! "$domain" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || [[ "$domain" == *..* ]]; then
        echo "Invalid DNS name" >&2
        exit 2
    fi
    umask 077
    output=$(mktemp -d "${TMPDIR:-/tmp}/litepod-cert.XXXXXX")
    cleanup() {
        rm -f -- "$output/cert.pem" "$output/key.pem"
        rmdir -- "$output"
    }
    trap cleanup EXIT
    openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 30 \
        -keyout "$output/key.pem" -out "$output/cert.pem" \
        -subj "/CN=$domain" -addext "subjectAltName=DNS:$domain" \
        -addext "basicConstraints=critical,CA:FALSE" \
        >/dev/null 2>&1
    printf '\n=== Certificate PEM: copy into Certificate chain ===\n'
    cat "$output/cert.pem"
    printf '\n=== Private key PEM: copy into Private key ===\n'
    cat "$output/key.pem"
    printf '\nPaste each complete BEGIN/END block into Settings → Certificates.\n'

# Fill request analytics locally: send `count` requests per app domain (or only `host`)
# through the dev Caddy on :8080, with a mix of paths (some 404s). Needs `just compose`
# and `just api` running. Rows show up on Analytics after the next one-minute flush.
analytics count="1000" host="" concurrency="16":
    #!/usr/bin/env bash
    set -euo pipefail
    db="{{justfile_directory()}}/api/data/litepod.db"
    if [ -n "{{host}}" ]; then
        hosts="{{host}}"
    else
        hosts=$(sqlite3 -readonly "$db" "SELECT DISTINCT lower(host) FROM application_domains")
    fi
    if [ -z "$hosts" ]; then
        echo "No app domains found: add a domain to an app, or pass host=<domain>." >&2
        exit 1
    fi
    paths=(/ / / / /api/items "/api/items?page=2" /login /static/app.js /favicon.ico /does-not-exist /api/health)
    echo "Sending {{count}} requests to each of: $(echo $hosts | tr '\n' ' ')via http://localhost:8080"
    for _ in $(seq 1 {{count}}); do
        for h in $hosts; do echo "$h ${paths[RANDOM % ${#paths[@]}]}"; done
    done | xargs -P {{concurrency}} -n 2 sh -c 'curl -s -o /dev/null -m 10 -H "Host: $0" "http://localhost:8080$1" || true'
    echo "Done. Wait about a minute for the flush, then open Analytics (organization or app tab)."

